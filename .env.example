# Credenciales de Odoo para el explorador.
#
# Copia este fichero a .env y rellénalo. El fichero .env está en .gitignore
# y el explorador NUNCA escribe estos valores en el informe.
#
# Cómo obtener la API key:
#   1. En Odoo, arriba a la derecha: tu nombre → Mi perfil → pestaña "Seguridad de la cuenta"
#   2. "Nueva clave de API" → te pedirá tu contraseña actual
#   3. Copia la clave: solo se muestra una vez
#
# Ojo en Odoo Online: si nunca has fijado una contraseña local (entras con
# Google, por ejemplo), primero hay que ponerla en Ajustes → Usuarios y compañías
# → Usuarios, o no podrás generar la key.

# URL de la instancia, con https:// y sin barra final
ODOO_URL=https://test-mdv-distribuidora.odoo.com

# Nombre EXACTO de la base de datos. Normalmente coincide con el subdominio,
# pero no siempre. Si falla la autenticación, este es el sospechoso habitual.
ODOO_DB=test-mdv-distribuidora

# El correo con el que entras a Odoo
ODOO_USER=tu.correo@mdv.com

# La clave de API generada arriba
ODOO_API_KEY=

# ---------------------------------------------------------------- IA local
#
# La redacción de fichas y la verificación de imágenes van por defecto contra
# un modelo local servido por Ollama, así que no hace falta ninguna clave.
# Instálalo desde https://ollama.com/download, arráncalo con «ollama serve» y
# trae los modelos:
#
#     ollama pull qwen2.5:7b
#     ollama pull qwen2.5vl:3b
#
# Comprueba que todo responde con «integra ia-probar» antes de lanzar el lote.

# ollama | anthropic | auto  (auto usa el local si responde)
IA_PROVEEDOR=ollama

# El 7b es el mas pequeno que redacta sin inventar: los de 3-4b confundieron
# "SEG GEN US" con "usado" y tradujeron nombres propios. Ver el README.
IA_MODELO=qwen2.5:7b
IA_MODELO_VISION=qwen2.5vl:3b

# Solo si Ollama corre en otra maquina.
# OLLAMA_HOST=http://192.168.0.20:11434

# Solo con IA_PROVEEDOR=anthropic.
# ANTHROPIC_API_KEY=
